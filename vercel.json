{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/web/manifest.json" },
    { "source": "/favicon.svg", "destination": "/web/favicon.svg" },
    { "source": "/(.*)", "destination": "/web/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
